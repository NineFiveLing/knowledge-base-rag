# ============================================
# 企业知识库 RAG 平台 — 环境变量
# 复制此文件为 .env 后修改
# ============================================

# =================== 数据库连接 ===================
# PostgreSQL (元信息 + PGVector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=ai_agent

# MongoDB (文档 Markdown 正文)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin123
MONGO_DB=knowledge_base

# Elasticsearch (全文检索)
ES_HOST=localhost
ES_PORT=9200

# Neo4j (知识图谱)
NEO4J_HOST=localhost
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j123456

# Redis (短期记忆)
REDIS_HOST=localhost
REDIS_PORT=6379

# RustFS (文件存储)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin

# =================== LLM 配置 ===================
# DeepSeek (意图识别 + 问答生成)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 阿里云兼容 OpenAI (OCR 多模态)
ALIYUN_API_KEY=your-aliyun-api-key
ALIYUN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIYUN_OCR_MODEL=qwen-vl-plus

# =================== ASR / TTS ===================
# 阿里云
ALIYUN_ASR_APP_KEY=your-aliyun-asr-app-key
ALIYUN_TTS_APP_KEY=your-aliyun-tts-app-key

# 腾讯云
TENCENT_ASR_SECRET_ID=your-tencent-secret-id
TENCENT_ASR_SECRET_KEY=your-tencent-secret-key
TENCENT_TTS_SECRET_ID=your-tencent-secret-id
TENCENT_TTS_SECRET_KEY=your-tencent-secret-key

# 默认 TTS/ASR 提供商: aliyun | tencent
DEFAULT_ASR_PROVIDER=aliyun
DEFAULT_TTS_PROVIDER=aliyun

# =================== LangFuse 监控 ===================
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# =================== Mem0 长期记忆 ===================
MEM0_API_KEY=your-mem0-api-key

# =================== JWT ===================
JWT_SECRET=change-me-to-a-random-string
JWT_EXPIRES_IN=7d

# =================== 阿里云 NLS 语音服务 ===================
# Placeholder，后续接入真实服务时填写
ALIYUN_NLS_APP_KEY=
ALIYUN_NLS_ACCESS_KEY_ID=
ALIYUN_NLS_ACCESS_KEY_SECRET=

# =================== 应用 ===================
NODE_ENV=development
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:5173
